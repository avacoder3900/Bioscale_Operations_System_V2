<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- OT2-LOG-1 L4: lab iMac link monitor. Install:
	     cp scripts/launchd/com.bims.linkmon.plist ~/Library/LaunchAgents/
	     edit the two paths below, then
	     launchctl load -w ~/Library/LaunchAgents/com.bims.linkmon.plist -->
	<key>Label</key>
	<string>com.bims.linkmon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/brevitest/github/Bioscale_Operations_System_V2/scripts/imac-linkmon.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Users/brevitest/Library/Logs/bims-linkmon.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/brevitest/Library/Logs/bims-linkmon.log</string>
</dict>
</plist>
