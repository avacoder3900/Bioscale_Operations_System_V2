# Tailscale on the OT-2's internal Pi — systemd unit (OT2-TAILNET-3).
#
# Binaries + state live on /data (survives reboots and Opentrons OS updates).
# userspace-networking: the Opentrons kernel lacks policy routing (netlink "create table:
# invalid argument" under kernel TUN). SSH + serve work fine in userspace mode.
# Install (OT-2 root filesystem is read-only — remount first), same as ot2-bridge.service:
#   mount -o remount,rw /
#   cp /data/tailscale/ot2-tailscale.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now ot2-tailscale
#   mount -o remount,ro /
#
# Logs: journalctl -u ot2-tailscale -f
# CLI:  /data/tailscale/tailscale --socket=/data/tailscale/tailscaled.sock status
#
# HTTPS mounts on https://ot2-<slot>.tailf65a70.ts.net (OT2-TAILNET-3 + -5):
#   /        -> http://localhost:31950   robot-server API (TAILNET-3)
#   /bridge  -> http://127.0.0.1:31960   ot2-bridge.py job server (TAILNET-5 S5)
# `serve --bg` persists in tailscaled.state, so these ExecStartPost lines only
# re-assert it (idempotent) after a state reset. Both are "-"-prefixed: a node
# that is not logged in yet (first boot, before `tailscale up`) must not fail
# the unit. /bridge is only mounted on a robot whose /data/ot2-bridge/.env has
# BRIDGE_TOKEN_SECRET, i.e. one that runs ot2-bridge 1.1+ with the job server —
# so installing this unit on a robot still on the old daemon changes nothing.
# scripts/ot2-tailnet-provision.sh applies the same two mounts directly.

[Unit]
Description=Tailscale node agent (BIMS OT-2 tailnet access)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/data/tailscale/tailscaled --state=/data/tailscale/tailscaled.state --socket=/data/tailscale/tailscaled.sock --port=41641 --tun=userspace-networking
ExecStartPost=-/data/tailscale/tailscale --socket=/data/tailscale/tailscaled.sock serve --bg --https=443 http://localhost:31950
ExecStartPost=-/bin/sh -c 'grep -q "^BRIDGE_TOKEN_SECRET=..*" /data/ot2-bridge/.env 2>/dev/null && exec /data/tailscale/tailscale --socket=/data/tailscale/tailscaled.sock serve --bg --https=443 --set-path=/bridge http://127.0.0.1:31960'
ExecStopPost=/data/tailscale/tailscaled --cleanup
Restart=on-failure
RestartSec=5
RuntimeDirectory=tailscale
StateDirectory=tailscale
CacheDirectory=tailscale

[Install]
WantedBy=multi-user.target
