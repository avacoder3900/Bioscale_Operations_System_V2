# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=brevitest-cv
R2_PUBLIC_URL=https://brevitest-cv.7bd6a45ccebc81a14aeac4cdc97030d5.r2.dev

# CV Worker Service (legacy local FastAPI worker; only used if CV_INFER_URL is set)
CV_WORKER_URL=http://localhost:8000

# CV inference: by default the SvelteKit /api/cv/infer route calls the co-located
# Vercel Python function at <origin>/api/ml/infer. Override only for local dev.
CV_INFER_URL=
# Shared secret guarding the Python inference function (set in Vercel + here).
ML_INFER_SECRET=

# CV training via GitHub Actions (ephemeral runner, no always-on host).
# These live in Vercel (BIMS side). GITHUB_DISPATCH_TOKEN lets BIMS fire the run.
GITHUB_DISPATCH_TOKEN=        # PAT with repo/contents:write to fire repository_dispatch
GITHUB_REPO=avacoder3900/Bioscale_Operations_System_V2
# Shared secret for the train-manifest / train-complete machine-to-machine routes.
# Must match the GitHub repo secret of the same name used by train_cli.py.
TRAIN_CALLBACK_SECRET=
# train-manifest hands the runner a model-upload target built from these
# (already set in Vercel for the capture flow). The runner itself needs NO R2
# creds — only BIMS_URL + TRAIN_CALLBACK_SECRET as GitHub repo secrets.
R2_WORKER_URL=
R2_UPLOAD_SECRET=
