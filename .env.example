# =====================================================================
# BIMS — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ---------- Database ----------
# MongoDB Atlas connection string (required at boot — most pages will 500
# without it). Format: mongodb+srv://USER:PASS@cluster.../db?appName=...
MONGODB_URI=

# ---------- Cron + agent auth ----------
# Vercel Cron secret — sent as Authorization: Bearer <CRON_SECRET> by
# scheduled cron jobs. Required for /api/cron/* endpoints to authenticate.
CRON_SECRET=

# Internal API key for non-user agents (openclaw worker, scanner bridge,
# manual sync scripts). Sent as `x-agent-api-key` header.
AGENT_API_KEY=

# Public base URL (used in emails, deep links). e.g. https://bims.brevitest.com
BIMS_BASE_URL=

# ---------- Ask BIMS (Anthropic) ----------
# Anthropic API key — required for /admin/ask-bims and the floating widget.
# Get one at https://console.anthropic.com/settings/keys
# Set a monthly spend cap in the Anthropic console as a bedrock guardrail.
ANTHROPIC_API_KEY=

# Per-user-per-day caps in USD (server-side enforced before each Anthropic
# call). Defaults shown — override only if your team's usage warrants it.
ASK_BIMS_DAILY_CAP_HAIKU_USD=1
ASK_BIMS_DAILY_CAP_SONNET_USD=2
ASK_BIMS_DAILY_CAP_OPUS_USD=5

# Workspace-wide daily cap (sums all users). Hits regardless of model.
ASK_BIMS_DAILY_CAP_WORKSPACE_USD=20

# Per-question hard cost ceiling on Opus 4.7 (USD). Aborts the agent loop
# if accumulated cost exceeds this on a single question.
ASK_BIMS_MAX_COST_OPUS=5

# Tool kill-switch — comma-separated list of tool names that should be
# filtered out before sending to Claude. Use to disable a buggy tool
# without a code deploy. Example: trace_cartridge,find_receiving_lot
ASK_BIMS_DISABLED_TOOLS=

# PII redaction toggle (Phase 6.1 — currently a no-op stub pending policy
# decision). Set to "1" once the redactPii() function has a real impl.
ASK_BIMS_PII_REDACTION_ENABLED=

# ---------- Ask BIMS voice input (Phase M.1, 2026-05-13) ----------
# OpenAI API key — only used by /api/agent/transcribe (Whisper). If absent,
# the widget hides the mic button gracefully (voice input is optional).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Workspace-wide daily cap (USD) on Whisper spend. Whisper-1 is $0.006/min,
# so $2/day = ~333 min of audio. Enforced before each /transcribe call.
ASK_BIMS_DAILY_CAP_WHISPER_USD=2

# ---------- Cloudflare R2 Storage ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=brevitest-cv
R2_PUBLIC_URL=https://brevitest-cv.7bd6a45ccebc81a14aeac4cdc97030d5.r2.dev

# CV Worker Service (legacy local FastAPI worker; only used if CV_INFER_URL is set)
CV_WORKER_URL=http://localhost:8000

# CV inference: by default the SvelteKit /api/cv/infer route calls the co-located
# Vercel Python function at <origin>/api/ml/infer. Override only for local dev.
CV_INFER_URL=
# Shared secret guarding the Python inference function (set in Vercel + here).
ML_INFER_SECRET=

# CV training via GitHub Actions (ephemeral runner, no always-on host).
# These live in Vercel (BIMS side). GITHUB_DISPATCH_TOKEN lets BIMS fire the run.
GITHUB_DISPATCH_TOKEN=        # PAT with repo/contents:write to fire repository_dispatch
GITHUB_REPO=avacoder3900/Bioscale_Operations_System_V2
# Shared secret for the train-manifest / train-complete machine-to-machine routes.
# Must match the GitHub repo secret of the same name used by train_cli.py.
TRAIN_CALLBACK_SECRET=
# train-manifest hands the runner a model-upload target built from these
# (already set in Vercel for the capture flow). The runner itself needs NO R2
# creds — only BIMS_URL + TRAIN_CALLBACK_SECRET as GitHub repo secrets.
R2_WORKER_URL=
R2_UPLOAD_SECRET=

# Robot Arm (SO-ARM101). Host is the Raspberry Pi `arm-pi`, on Tailscale.
# `alejandros-pc` is RETIRED as a deployment target — never point at it.
#
# Local dev — BIMS on a tailnet device (MagicDNS):
#   ROBOT_ARM_BASE_URL=http://arm-pi:8000
#
# Vercel production — Tailscale Funnel URL (public HTTPS):
#   ROBOT_ARM_BASE_URL=https://arm-pi.tailf65a70.ts.net
#
# Setup: robot-arm repo docs/tailscale.md.
# The API key must match ROBOT_ARM_API_KEY in ~/robot-arm/.env on arm-pi.
ROBOT_ARM_BASE_URL=http://arm-pi:8000
ROBOT_ARM_API_KEY=
