# Robot Arm (SO-ARM101, Windows host alejandros-pc, reachable via Tailscale)
#
# Local dev — BIMS on the same machine as FastAPI (alejandros-pc):
#   ROBOT_ARM_BASE_URL=http://localhost:8000
#
# Local dev — BIMS on a different tailnet device:
#   ROBOT_ARM_BASE_URL=http://alejandros-pc:8000
#
# Vercel production — use the Tailscale Funnel URL:
#   ROBOT_ARM_BASE_URL=https://alejandros-pc.tailf65a70.ts.net
#
# Setup: robot-arm repo docs/tailscale.md.
# The API key must match the FastAPI server's env on alejandros-pc.
ROBOT_ARM_BASE_URL=http://localhost:8000
ROBOT_ARM_API_KEY=
