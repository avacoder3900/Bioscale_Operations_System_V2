# Base URL of the BIMS deployment the MCP server should query.
# Local dev:   http://localhost:5173
# Production:  https://your-bims-domain.example.com
BIMS_BASE_URL=http://localhost:5173

# The agent API key BIMS expects (matches AGENT_API_KEY in the BIMS env).
# The MCP server sends this to BIMS as x-api-key on every request.
AGENT_API_KEY=replace-with-bims-agent-api-key

# Transport: "stdio" (default, for local Claude Code/Desktop) or "http" (remote/phone).
MCP_TRANSPORT=stdio

# --- HTTP transport only (ignored for stdio) ---
# Port the HTTP MCP server listens on.
PORT=8787
# Bearer token clients (Claude mobile / Claude Code remote) must present.
# REQUIRED in http mode. Generate a long random string.
MCP_BEARER_TOKEN=replace-with-a-long-random-secret
